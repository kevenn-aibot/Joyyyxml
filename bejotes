<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>StoryForge AI — Story & Scene Builder</title>
<meta name="description" content="AI Story Builder, Character Builder, Scene Breakdown dan Final Storyboard.">
<style>
*{box-sizing:border-box}body{margin:0;font-family:Inter,Arial,sans-serif;background:#070a10;color:#eef2ff}
:root{--p:#7c5cff;--bg:#0c111a;--card:#111823;--line:#263246;--muted:#94a0b4}
.app{display:flex;min-height:100vh}.side{width:250px;background:#0a0e15;border-right:1px solid var(--line);padding:20px;position:sticky;top:0;height:100vh}
.logo{font-size:22px;font-weight:900;margin-bottom:28px}.logo b{color:var(--p)}.step{display:flex;gap:10px;align-items:center;padding:12px;border-radius:10px;color:#aeb9ca;margin:4px 0}.step.active{background:#19152d;color:#fff}.num{width:27px;height:27px;border-radius:50%;display:grid;place-items:center;background:#20293a;font-size:12px}
.main{flex:1;padding:24px;max-width:1450px;margin:auto;width:100%}.top{display:flex;justify-content:space-between;gap:15px;align-items:center;margin-bottom:20px}.top h1{margin:0;font-size:28px}.top p{color:var(--muted);margin:5px 0}.badge{border:1px solid #33415b;background:#131b29;padding:8px 12px;border-radius:99px;font-size:12px}
.grid{display:grid;grid-template-columns:390px 1fr;gap:18px}.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;margin-bottom:18px}h2{font-size:17px;margin:0 0 15px}label{display:block;color:#cbd3e1;font-size:13px;margin:12px 0 6px}input,select,textarea{width:100%;background:#090e16;color:#eef2ff;border:1px solid #2a374b;border-radius:10px;padding:11px;outline:none}textarea{min-height:85px;resize:vertical}.row{display:grid;grid-template-columns:1fr 1fr;gap:9px}.btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.btn{border:0;border-radius:10px;padding:11px 14px;cursor:pointer;font-weight:800}.primary{background:linear-gradient(135deg,#815eff,#5c42df);color:#fff}.secondary{background:#1a2331;color:#dce5f4;border:1px solid #2c394d}.scene{background:#0b111a;border:1px solid #29364b;border-radius:14px;margin:12px 0;overflow:hidden}.scenehead{padding:14px 15px;background:#121a26;display:flex;justify-content:space-between;gap:10px;align-items:center}.scenehead h3{margin:0;font-size:16px}.tag{font-size:11px;color:#aebbd0}.body{padding:15px}.field{margin-bottom:13px}.field strong{display:block;color:#b8aaff;font-size:12px;text-transform:uppercase;margin-bottom:5px}.text{white-space:pre-wrap;line-height:1.55;color:#d6deed}.empty{color:#718096;text-align:center;padding:70px 20px;border:1px dashed #2b3749;border-radius:12px}.final{white-space:pre-wrap;background:#090e15;border:1px solid #273449;border-radius:12px;padding:15px;line-height:1.6;max-height:500px;overflow:auto}.hidden{display:none}.footer{text-align:center;color:#657187;font-size:12px;padding:15px}@media(max-width:900px){.side{display:none}.main{padding:14px}.grid{grid-template-columns:1fr}.top h1{font-size:22px}}
</style>
</head>
<body>
<div class="app">
<aside class="side">
 <div class="logo">StoryForge <b>AI</b></div>
 <div class="step active"><span class="num">1</span> Ide User</div>
 <div class="step"><span class="num">2</span> Story Builder</div>
 <div class="step"><span class="num">3</span> Character Builder</div>
 <div class="step"><span class="num">4</span> Scene Breakdown</div>
 <div class="step"><span class="num">5</span> Final Storyboard</div>
</aside>
<main class="main">
 <div class="top">
  <div><h1>AI Story & Scene Builder</h1><p>Ide → cerita → karakter → scene → prompt → storyboard.</p></div>
  <div class="badge">Standalone • GitHub / Blogger</div>
 </div>

 <div class="grid">
  <section>
   <div class="card">
    <h2>💡 1. Ide User</h2>
    <label>Ide cerita / konsep</label>
    <textarea id="idea" placeholder="Contoh: pasangan muda pergi memancing di sungai, lalu menemukan sesuatu yang misterius..."></textarea>
    <div class="row">
     <div><label>Genre</label><select id="genre"><option>Drama</option><option>Romance</option><option>Action</option><option>Horror</option><option>Comedy</option><option>Cerita rakyat</option><option>Adventure</option><option>Advertisement</option></select></div>
     <div><label>Jumlah scene</label><select id="count"><option>4</option><option>6</option><option selected>8</option><option>10</option><option>12</option></select></div>
    </div>
    <div class="row">
     <div><label>Durasi</label><select id="duration"><option>30 detik</option><option selected>60 detik</option><option>90 detik</option><option>3 menit</option><option>5 menit</option></select></div>
     <div><label>Rasio</label><select id="ratio"><option selected>9:16</option><option>16:9</option><option>1:1</option><option>4:5</option></select></div>
    </div>
    <label>Gaya visual</label><select id="style"><option>Cinematic realistis</option><option>Photorealistic</option><option>Luxury commercial</option><option>Anime cinematic</option><option>3D animation</option><option>Dark cinematic</option><option>Fantasy</option><option>Documentary</option></select>
    <label>Detail tambahan</label><textarea id="details" placeholder="Lokasi, pakaian, warna, suasana, target penonton, produk, dll."></textarea>
    <div class="btns"><button class="btn primary" onclick="build()">✨ Bangun Storyboard</button><button class="btn secondary" onclick="resetAll()">Reset</button></div>
   </div>

   <div class="card">
    <h2>🧑‍🎨 3. Character Builder</h2>
    <label>Karakter utama</label><textarea id="chars" placeholder="Contoh: pria 25 tahun, rambut hitam pendek, kaos hitam; wanita 23 tahun, rambut panjang, jaket cokelat."></textarea>
    <div class="btns"><button class="btn secondary" onclick="suggestChars()">✨ Isi dari ide</button></div>
   </div>
  </section>

  <section>
   <div class="card">
    <div class="btns" style="justify-content:space-between;margin-top:0"><h2 style="margin:8px 0">🎞️ 4. Scene Breakdown</h2><div><button class="btn secondary" onclick="copyAll()">📋 Copy Semua</button> <button class="btn secondary" onclick="download()">💾 TXT</button></div></div>
    <div id="scenes"><div class="empty">Masukkan ide lalu tekan <b>Bangun Storyboard</b>.</div></div>
   </div>
   <div class="card">
    <h2>🎬 5. Final Storyboard</h2>
    <div id="final" class="final">Belum ada storyboard.</div>
   </div>
  </section>
 </div>
 <div class="footer">StoryForge AI — Generator struktur prompt. Untuk AI API sungguhan, sambungkan endpoint server/API pada tahap berikutnya.</div>
</main>
</div>

<script>
let data={scenes:[],final:''};
const $=id=>document.getElementById(id);
const v=id=>$(id).value;
function safe(s){return String(s||'').replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]))}
function build(){
 const idea=v('idea')||'Konsep cerita kreatif';
 const genre=v('genre'), count=+v('count'), dur=v('duration'), ratio=v('ratio'), style=v('style'), details=v('details')||'detail natural dan profesional';
 const chars=v('chars')||'Karakter utama yang konsisten dengan kebutuhan cerita';
 const actions=['opening memperkenalkan dunia, lokasi dan karakter','karakter mulai menjalankan tujuan utama','muncul petunjuk atau kejadian yang mengubah situasi','konflik mulai meningkat dan karakter mengambil keputusan','momen paling intens atau titik balik cerita','karakter menghadapi konsekuensi dan mencari solusi','masalah mulai terselesaikan dan emosi mencapai puncak','ending cinematic yang meninggalkan kesan'];
 data.scenes=[];
 for(let i=1;i<=count;i++){
   const act=actions[(i-1)%actions.length];
   data.scenes.push({i,act,idea,genre,dur,ratio,style,details,chars});
 }
 render();
}
function render(){
 let html='';
 let final=`FINAL STORYBOARD\nTITLE: ${v('idea')||'Untitled'}\nGENRE: ${v('genre')}\nDURATION: ${v('duration')}\nFORMAT: ${v('ratio')}\nSTYLE: ${v('style')}\n\nCHARACTER CONSISTENCY:\n${v('chars')||'Karakter konsisten sesuai cerita.'}\n\n`;
 data.scenes.forEach(s=>{
 const image=`${s.idea}. ${s.act}. ${s.chars}. Environment immersive, ${s.style}, realistic facial details, natural skin texture, cinematic composition, ${s.ratio}, realistic lighting and shadows, professional photography, highly detailed, 4K. Maintain exact character identity, clothing and props from previous scenes.`;
 const video=`Create a ${s.dur} video scene about ${s.idea}. Action: ${s.act}. Characters: ${s.chars}. Cinematic realistic motion, natural body movement, believable physics, smooth camera movement, professional cinematography, ${s.style}, realistic lighting, depth of field, detailed environment, ${s.ratio}. Maintain exact face, hairstyle, clothing, body proportions and props. No morphing, flickering, duplicated subjects, broken anatomy or text artifacts.`;
 const dialogue=`Dialog natural sesuai genre ${s.genre}; karakter merespons kejadian pada scene ini dan mendorong cerita ke scene berikutnya.`;
 const vo=`Narasi/voice-over singkat: menjelaskan perkembangan kejadian pada scene ${s.i} dengan emosi yang sesuai.`;
 const camera=`Camera: cinematic establishing/medium/close-up sesuai aksi; smooth pan, tracking atau dolly; depth of field realistis; fokus berpindah ke subjek utama.`;
 const lighting=`Lighting: natural cinematic lighting sesuai waktu dan lokasi, realistic highlights, shadows and reflections.`;
 const sfx=`SFX: ambience lokasi, suara langkah/air/angin/objek yang bergerak sesuai aksi; music bed cinematic lembut dan tidak menutupi dialog.`;
 html+=`<article class="scene"><div class="scenehead"><h3>SCENE ${String(s.i).padStart(2,'0')}</h3><span class="tag">${safe(s.act)}</span></div><div class="body">
 ${field('IMAGE PROMPT',image)}${field('VIDEO PROMPT',video)}${field('DIALOGUE',dialogue)}${field('VOICE OVER',vo)}${field('CAMERA',camera)}${field('LIGHTING',lighting)}${field('SFX',sfx)}
 </div></article>`;
 final+=`SCENE ${String(s.i).padStart(2,'0')}\nACTION: ${s.act}\nIMAGE PROMPT: ${image}\nVIDEO PROMPT: ${video}\nDIALOGUE: ${dialogue}\nVOICE OVER: ${vo}\nCAMERA: ${camera}\nLIGHTING: ${lighting}\nSFX: ${sfx}\n\n----------------------------------------\n\n`;
 });
 $('scenes').innerHTML=html;$('final').textContent=final;data.final=final;
}
function field(title,text){return `<div class="field"><strong>${title}</strong><div class="text">${safe(text)}</div></div>`}
function suggestChars(){ $('chars').value='Pria muda 25 tahun, rambut hitam pendek, wajah natural, kaos hitam dan celana kasual; wanita muda 23 tahun, rambut panjang, pakaian kasual elegan. Pertahankan wajah, rambut, pakaian dan proporsi tubuh konsisten di semua scene.'}
function copyAll(){if(!data.final){alert('Buat storyboard dulu.');return}navigator.clipboard.writeText(data.final).then(()=>alert('Semua storyboard berhasil dicopy.'))}
function download(){if(!data.final){alert('Buat storyboard dulu.');return}const b=new Blob([data.final],{type:'text/plain;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='storyforge-storyboard.txt';a.click();URL.revokeObjectURL(a.href)}
function resetAll(){$('idea').value='';$('details').value='';$('chars').value='';$('scenes').innerHTML='<div class="empty">Masukkan ide lalu tekan <b>Bangun Storyboard</b>.</div>';$('final').textContent='Belum ada storyboard.';data={scenes:[],final:''}}
</script>
</body>
</html>
