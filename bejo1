import streamlit as st
import google.generativeai as genai
import requests
from PIL import Image
import io
import urllib.parse

# -----------------------------------------------------------------------------
# Configuration & Setup
# -----------------------------------------------------------------------------
st.set_page_config(
    page_title="All-in-One AI Studio",
    page_icon="🚀",
    layout="wide"
)

st.title("🚀 All-in-One AI Content Studio")
st.caption("Solusi AI untuk Affiliate, Naskah Drama, Cerita Rakyat, dan Pembuat Gambar")

# Sidebar - API Key Setup & Navigation
st.sidebar.header("⚙️ Pengaturan")
api_key = st.sidebar.text_input("Masukkan Gemini API Key:", type="password")

if not api_key:
    st.info("💡 Silakan masukkan **Gemini API Key** kamu di sidebar untuk memulai.")
    st.stop()

# Initialize Gemini Model
genai.configure(api_key=api_key)
model = genai.GenerativeModel('gemini-1.5-flash')

# Navigation Menu
menu = st.sidebar.radio(
    "Pilih Modul AI:",
    ["🛒 Affiliate Marketing", "🎭 Naskah Drama", "📚 Cerita Rakyat", "🎨 Generator Gambar AI"]
)

# -----------------------------------------------------------------------------
# Modul 1: Affiliate Marketing
# -----------------------------------------------------------------------------
if menu == "🛒 Affiliate Marketing":
    st.header("🛒 AI Generator Konten Affiliate")
    
    col1, col2 = st.columns(2)
    with col1:
        product_name = st.text_input("Nama Produk:", placeholder="Contoh: Skincare Serum Brightening")
        target_platform = st.selectbox("Platform:", ["TikTok / Reel Video Script", "Instagram Caption", "Shopee/Tokopedia Description", "Twitter / X Thread"])
    with col2:
        benefits = st.text_area("Keunggulan Produk / Promo:", placeholder="Contoh: Mencerahkan 7 hari, diskon 50%, free ongkir")
        tone = st.selectbox("Gaya Bahasa:", ["Persuasif & Santai (Gen Z)", "Profesional & Informatif", "Bohay / Soft Selling", "Emosional / Storytelling"])

    if st.button("✨ Buat Konten Affiliate"):
        if product_name and benefits:
            prompt = f"""
            Kamu adalah expert Affiliate Marketer. Buatkan konten promosi untuk produk berikut:
            - Nama Produk: {product_name}
            - Keunggulan/Promo: {benefits}
            - Platform Target: {target_platform}
            - Tone Bahasa: {tone}

            Berikan output lengkap termasuk:
            1. Hook / Judul yang memancing perhatian.
            2. Isi Konten / Skrip Utama (lengkap dengan arahan visual jika untuk video).
            3. Call to Action (CTA) agar pembeli klik link affiliate.
            4. Rekomendasi Hashtag relevan.
            """
            with st.spinner("Sedang meracik konten hoki..."):
                response = model.generate_content(prompt)
                st.markdown(response.text)
        else:
            st.warning("Harap isi Nama Produk dan Keunggulannya terlebih dahulu.")

# -----------------------------------------------------------------------------
# Modul 2: Naskah Drama
# -----------------------------------------------------------------------------
elif menu == "🎭 Naskah Drama":
    st.header("🎭 AI Pembuat Skrip & Naskah Drama")
    
    title = st.text_input("Judul / Tema Drama:", placeholder="Contoh: Pengkhianatan di Rumah Tua")
    col1, col2 = st.columns(2)
    with col1:
        genre = st.selectbox("Genre:", ["Drama Komedi", "Horor / Misteri", "Romantis", "Laga / Aksi", "Tragedi Emosional"])
        num_characters = st.number_input("Jumlah Karakter Utama:", min_value=1, max_value=6, value=3)
    with col2:
        setting = st.text_input("Latar Tempat & Waktu:", placeholder="Contoh: Cafe tua saat hujan deras malam hari")
        plot_summary = st.text_area("Ringkasan Plot Singkat:", placeholder="Contoh: Dua sahabat berebut dokumen rahasia milik orang tua mereka.")

    if st.button("🎬 Hasilkan Skrip Drama"):
        if title:
            prompt = f"""
            Buatkan naskah drama lengkap dan menarik berdasarkan parameter berikut:
            - Judul/Tema: {title}
            - Genre: {genre}
            - Jumlah Karakter: {num_characters}
            - Latar: {setting}
            - Ringkasan Plot: {plot_summary}

            Sajikan dalam format naskah standar:
            1. Daftar Karakter & Deskripsi Singkat.
            2. Deskripsi Panggung / Adegan Pembuka.
            3. Dialog lengkap beserta petunjuk akting dalam kurung (contoh: (tersenyum sinis)).
            4. Plot twist di tengah atau akhir adegan.
            """
            with st.spinner("Sedang menulis naskah..."):
                response = model.generate_content(prompt)
                st.markdown(response.text)
        else:
            st.warning("Harap masukkan Judul / Tema Drama.")

# -----------------------------------------------------------------------------
# Modul 3: Cerita Rakyat
# -----------------------------------------------------------------------------
elif menu == "📚 Cerita Rakyat":
    st.header("📚 AI Penulis Cerita Rakyat & Dongeng")
    
    col1, col2 = st.columns(2)
    with col1:
        folklore_title = st.text_input("Judul / Asal Cerita:", placeholder="Contoh: Legenda Danau Biru / Dongeng Kancil Pintar")
        main_character = st.text_input("Tokoh Utama:", placeholder="Contoh: Pemuda miskin yang jujur & Naga Penjaga")
    with col2:
        moral_lesson = st.text_input("Pesan Moral:", placeholder="Contoh: Kejujuran membawa keberuntungan")
        style = st.selectbox("Gaya Cerita:", ["Gaya Klasik Nusantara", "Dongeng Anak-Anak Edukatif", "Epos / Petualangan Fantasi"])

    if st.button("📖 Buat Cerita Rakyat"):
        if folklore_title:
            prompt = f"""
            Buatkan cerita rakyat / dongeng yang kaya akan budaya dan imajinatif:
            - Judul: {folklore_title}
            - Tokoh Utama: {main_character}
            - Pesan Moral: {moral_lesson}
            - Gaya Bahasa: {style}

            Struktur cerita:
            1. Orientasi (Pengenalan tokoh dan latar tempat).
            2. Komplikasi (Konflik utama atau rintangan yang dihadapi).
            3. Resolusi (Penyelesaian masalah).
            4. Koda (Pesan moral eksplisit untuk pembaca).
            """
            with st.spinner("Sedang merangkai cerita..."):
                response = model.generate_content(prompt)
                st.markdown(response.text)
        else:
            st.warning("Harap masukkan Judul cerita.")

# -----------------------------------------------------------------------------
# Modul 4: AI Image Generator
# -----------------------------------------------------------------------------
elif menu == "🎨 Generator Gambar AI":
    st.header("🎨 AI Generator Gambar & Prompt")
    
    user_idea = st.text_input("Deskripsikan gambar yang kamu inginkan (Bahasa Indonesia):", 
                              placeholder="Contoh: Putri kerajaan Indonesia memakai pakaian adat modern di kota masa depan")
    
    art_style = st.selectbox("Gaya Seni Gambar:", ["Photorealistic", "Anime / Manga", "Digital Painting", "Cyberpunk", "3D Render / Pixar Style", "Indonesian Batik Fantasy"])

    if st.button("🖼️ Generate Gambar & Prompt"):
        if user_idea:
            with st.spinner("1. Menerjemahkan & mengoptimalkan prompt visual..."):
                # Buat prompt Bahasa Inggris profesional via Gemini
                prompt_gen = f"""
                Convert this user image idea into a highly detailed English image generation prompt for Stable Diffusion/Midjourney:
                Idea: {user_idea}
                Art Style: {art_style}
                
                Output ONLY the raw English prompt without any extra explanation or quotes.
                """
                english_prompt = model.generate_content(prompt_gen).text.strip()
            
            st.subheader("📌 Optimized English Prompt:")
            st.code(english_prompt)

            with st.spinner("2. Menggambar dengan AI..."):
                try:
                    # Menggunakan Pollinations API (Gratis)
                    encoded_prompt = urllib.parse.quote(english_prompt)
                    image_url = f"https://image.pollinations.ai/prompt/{encoded_prompt}?width=1024&height=1024&nologo=true"
                    
                    response = requests.get(image_url)
                    img = Image.open(io.BytesIO(response.content))
                    
                    st.image(img, caption=f"Hasil Gambar: {user_idea}", use_column_width=True)
                except Exception as e:
                    st.error(f"Gagal memuat gambar: {e}")
        else:
            st.warning("Harap masukkan deskripsi gambar.")
